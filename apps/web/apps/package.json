{
  "name": "kapit-bisig-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:next": "node scripts/clean-next-artifacts.js",
    "dev": "node scripts/dev-with-warmup.js 3000",
    "dev:fast": "node scripts/free-port.js 3000 && next dev --turbo -p 3000",
    "dev:clean": "node scripts/free-port.js 3000 && npm run clean:next && node scripts/dev-with-warmup.js 3000",
    "dev:webpack": "node scripts/free-port.js 3000 && set NEXT_DEV_USE_WEBPACK=true && next dev -p 3000",
    "build": "npm run clean:next && next build",
    "start": "next start",
    "lint": "next lint",
    "server": "node scripts/free-port.js 3001 && ts-node --project tsconfig.server.json server/index.ts",
    "server:dev": "node scripts/free-port.js 3001 && nodemon --watch server --ext ts,js,json --exec ts-node --transpile-only --project tsconfig.server.json server/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "server:prod": "node dist/index.js",
    "seed:reset": "node server/scripts/resetSeededData.js",
    "seed:households:10x10": "node server/scripts/seedClaimHouseholds10x10.js",
    "seed:distributions:10x10": "node server/scripts/seedClaimDistributions10x10.js",
    "seed:claimflow:10x10": "npm run seed:reset && npm run seed:households:10x10 && npm run seed:distributions:10x10",
    "seed:brgy5x10": "node server/scripts/seedBrgy5x10.js",
    "seed:brgy:loadtest": "node server/scripts/seedBrgy5x10.js",
    "seed:target-beneficiary-demo": "ts-node --project tsconfig.server.json server/scripts/seedTargetBeneficiaryDemo.ts",
    "generate:qr-sheet": "node server/scripts/generateResidentQrSheet.js",
    "demo:scan:san-jose": "ts-node --project tsconfig.server.json server/scripts/runSanJoseScanDemo.ts",
    "migrate:distribution-ends": "ts-node --project tsconfig.server.json server/scripts/backfillDistributionEndsAt.ts",
    "migrate:superadmin": "ts-node --project tsconfig.server.json server/scripts/transferSuperadminToDb.ts",
    "seed:link-claim-tokens": "node server/scripts/linkSeededClaimTokens.js",
    "test:risk2-logs": "ts-node --project tsconfig.server.json server/scripts/testRisk2Logging.ts",
    "test:distribution-flow": "ts-node --project tsconfig.server.json server/test/runDistributionFlowTests.ts",
    "test:resident-distribution-feed": "ts-node --project tsconfig.server.json server/test/residentDistributionFeed.integration.ts",
    "test:offline-proof-sync": "ts-node --project tsconfig.server.json server/test/runOfflineProofSyncTests.ts",
    "test:sms": "ts-node --project tsconfig.server.json server/scripts/testSms.ts",
    "test:auth:newman": "npx newman run ../../../docs/postman/KapitBisig_Auth_Security.postman_collection.json -e ../../../docs/postman/KapitBisig_Local.postman_environment.json --reporters cli",
    "test:auth:newman:insecure": "npx newman run ../../../docs/postman/KapitBisig_Auth_Security.postman_collection.json -e ../../../docs/postman/KapitBisig_Local.postman_environment.json --reporters cli --insecure"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/multer": "^2.0.0",
    "bcrypt": "^5.1.1",
    "canvas": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "face-api.js": "^0.22.2",
    "framer-motion": "^12.34.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.575.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "next": "14.0.4",
    "nodemailer": "^8.0.1",
    "nprogress": "^0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "sweetalert2": "^11.26.20",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.1.1",
    "vercel__ms": "npm:ms@^2.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.10",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "supertest": "^7.1.1",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
