# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.65      # Similarity threshold for verification
DUPLICATE_THRESHOLD=0.70       # Threshold for duplicate detection (BLOCK if similarity >= this)
MIN_FACE_SIZE=80               # Minimum face size in pixels (lower for low-end cameras)
MODEL_NAME=Facenet-ONNX        # FaceNet ONNX embedding model (512-d)
DETECTOR_BACKEND=opencv        # Face detector (opencv, retinaface, mtcnn)
BLUR_THRESHOLD=18              # Image sharpness threshold (lower = more tolerant)
LIVENESS_MIN_PASSES=1          # Keep anti-spoofing on but lenient
LOW_RES_THRESHOLD=360          # Treat only very low-res images as low quality
MAX_IMAGE_DIM=800              # Max image dimension (resize for speed)

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=kapit_bisig
FACE_API_ALLOWED_ORIGINS=http://192.168.1.4:3000,http://localhost:3000

# For MongoDB Atlas (cloud), use:
# MONGODB_URI=mongodb+srv://cluster0.example.mongodb.net/kapit_bisig?retryWrites=true&w=majority


